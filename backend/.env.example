# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Database (PostgreSQL via Docker, see docker-compose.yml) ----
DATABASE_URL="postgresql://elite_events:elite_events_dev_password@localhost:5432/elite_events"

# ---- Auth ----
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Hardcoded Admin credentials (single Admin account, per spec)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"

# ---- OTP (Admin second factor) ----
OTP_LENGTH=8
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Hardcoded recipient inbox for OTP codes
ADMIN_OTP_EMAIL="admin@example.com"

# ---- Email (SMTP relay - e.g. Brevo, SendGrid) ----
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="Elite Events <no-reply@elite-events.example.com>"

# ---- CORS ----
FRONTEND_URL="http://localhost:4200"

CAMPAY_APP_ID=
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_PERMANENT_ACCESS_TOKEN=
CAMPAY_WEBHOOK_KEY=
CAMPAY_WEBHOOK_URL=https://quail-unbundle-oboe.ngrok-free.dev/webhooks/campay
CAMPAY_MODE=sandbox